# ════════════════════════════════════════════════════════════════════════════
#  CLIENT ONBOARDING BRIDGE — Environment Variables Template
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to version control.
# ════════════════════════════════════════════════════════════════════════════

# ─── Switch Local Server ────────────────────────────────────────────────────
SWITCH_SERVER_HOST=127.0.0.1
SWITCH_SERVER_PORT=8080
SWITCH_SERVER_API_KEY=REPLACE_ME

# ─── OpenCode ───────────────────────────────────────────────────────────────
OPENCODE_API_ENDPOINT=http://localhost:3000
OPENCODE_API_KEY=REPLACE_ME
OPENCODE_MODEL=REPLACE_ME            # e.g. gpt-4o, claude-3-5-sonnet, etc.

# ─── PHOTON Local Controller ────────────────────────────────────────────────
PHOTON_HOST=127.0.0.1
PHOTON_PORT=9090
PHOTON_AUTH_TOKEN=REPLACE_ME

# ─── Telegram ───────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=REPLACE_ME        # From @BotFather
TELEGRAM_INTAKE_CHAT_ID=REPLACE_ME   # bridge-intake room numeric ID
TELEGRAM_DELIVERY_CHAT_ID=REPLACE_ME # Approved-delivery room numeric ID
TELEGRAM_WEBHOOK_SECRET=REPLACE_ME

# ─── Slack ──────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-REPLACE_ME
SLACK_SIGNING_SECRET=REPLACE_ME
SLACK_INTAKE_CHANNEL=bridge-intake          # channel name (no #)
SLACK_SPEC_CHANNEL=bridge-spec
SLACK_QUOTE_CHANNEL=bridge-quote
SLACK_DEMO_CHANNEL=bridge-demo
SLACK_APPROVALS_CHANNEL=bridge-approvals    # PM approval thread
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE_ME

# ─── Bridge Rooms (logical IDs, resolved per connector) ─────────────────────
ROOM_INTAKE=bridge-intake
ROOM_SPEC=bridge-spec
ROOM_QUOTE=bridge-quote
ROOM_DEMO=bridge-demo

# ─── PM Approval ────────────────────────────────────────────────────────────
PM_SLACK_USER_ID=REPLACE_ME          # e.g. U01ABCDEFGH
APPROVAL_TIMEOUT_HOURS=24

# ─── App General ────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
PORT=4000
